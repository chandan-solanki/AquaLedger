# AquaLedger Backend — Production Environment Template (Sprint 18 Session 3)
#
# Copy this to `backend/.env` on the VPS and fill in real values. Never
# commit the filled-in file. This is a template with reasoning, not a
# ready-to-run file — every placeholder below must be replaced.

# --- Application ---
APP_NAME=FishERP
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- CORS ---
# The real public origin(s) the frontend is served from - comma-separated,
# no trailing slash. The backend itself is never publicly reachable in
# this architecture (see DEPLOYMENT.md "Network topology"), so this only
# matters for the one path that does cross an origin boundary today: the
# Swagger UI at /docs making requests from the browser directly against
# this API when someone opens it. Set it to the real domain regardless.
CORS_ORIGINS=https://your-domain.example

# --- Database ---
# `postgres` below is the Docker Compose service name, not `localhost` -
# resolved via the Compose-managed internal network (see
# docker-compose.prod.yml).
DATABASE_URL=postgresql+asyncpg://REPLACE_ME_USER:REPLACE_ME_PASSWORD@postgres:5432/fisherp

# Sized for exactly one backend worker process (see DEPLOYMENT.md
# "Backend process model" for why one worker was chosen) on a 1 vCPU / 6
# GB VPS with PostgreSQL co-located on the same box:
#   - pool_size=5 + max_overflow=5 = 10 connections max from this process,
#     comfortably inside PostgreSQL's default max_connections=100 even
#     with headroom for psql/monitoring/a future second service.
#   - The previous defaults (10/20 = 30 max) were sized as if multiple
#     workers or high concurrency were already in play - oversized for
#     one worker, and each idle Postgres backend process costs the
#     database server RSS that matters when Postgres and the app share
#     the same 6 GB.
#   - This is NOT a tiny pool that would serialize ordinary traffic: 10
#     concurrent in-flight queries is well above what one Uvicorn worker
#     handling typical ERP request patterns (mostly short queries, no
#     long-held transactions) will need concurrently.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Never true in production - see app/core/logging.py's own reasoning
# (Sprint 18 Session 1 audit): SQL echo logs bound parameter values
# (money amounts, PII) with no redaction, and adds real per-query
# overhead on a CPU-constrained box.
DATABASE_ECHO=false

# --- Logging ---
LOG_LEVEL=INFO
# JSON lines, not the human-readable dev ConsoleRenderer - what makes
# `docker compose logs` output greppable/parseable in production.
LOG_JSON=true

# --- Security - JWT ---
# Generate a real value on the deployment host, never reuse this example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security - password policy ---
PASSWORD_MIN_LENGTH=8

# --- Security - login rate limiting / account lockout ---
# These live in an in-process dict (InMemoryLoginRateLimiter,
# app/modules/auth/security.py) - correct and sufficient ONLY because the
# process model decision for this VPS is exactly one backend worker.
# Running more than one worker would let an attacker bypass this by
# landing requests on different processes - do not raise --workers above
# 1 without first replacing this with a shared store.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Document Engine ---
# Relative to the backend's working directory inside the container
# (/app) - must line up with the volume mount in docker-compose.prod.yml
# so generated invoice/receipt/etc. PDFs survive a container recreate.
DOCUMENT_STORAGE_ROOT=storage/documents
