# AquaLedger — Root Production Environment Template (Sprint 18 Session 3)
#
# This file is for `docker compose` ITSELF (variable substitution inside
# docker-compose.prod.yml and build args) — copy it to `.env` at the repo
# root on the VPS. It is separate from `backend/.env` and `frontend/`'s
# build args because Compose only auto-loads a `.env` from its own
# directory for `${VAR}` substitution; it does not reach into
# `backend/.env.production.example` for that.
#
# IMPORTANT: the Postgres credentials below MUST match the ones you put
# into backend/.env's DATABASE_URL — nothing keeps these two files in
# sync automatically. See DEPLOYMENT.md "Environment configuration".

# --- PostgreSQL (used by the `postgres` service AND must match
# backend/.env's DATABASE_URL) ---
POSTGRES_USER=REPLACE_ME_USER
POSTGRES_PASSWORD=REPLACE_ME_PASSWORD
POSTGRES_DB=fisherp

# --- Frontend build args (NEXT_PUBLIC_* — baked into the image at build
# time, see frontend/Dockerfile) ---
NEXT_PUBLIC_API_URL=http://backend:8000/api/v1
NEXT_PUBLIC_APP_NAME=AquaLedger
NEXT_PUBLIC_APP_ENV=production
