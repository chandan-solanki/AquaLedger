# AquaLedger Frontend — Environment Variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file containing real secrets.
#
# Loading strategy:
# - `.env.local` — local overrides, gitignored, loaded in all environments.
# - `.env.development` / `.env.production` — environment-specific defaults, safe to commit.
# - Variables prefixed `NEXT_PUBLIC_` are inlined into the client bundle at build time
#   and must never hold secrets; everything else stays server-only (BFF route handlers,
#   server components).

# --- API ---
# Base URL of the FastAPI backend, including the /api/v1 prefix.
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (example):
# NEXT_PUBLIC_API_URL=https://api.aqualedger.com/api/v1

# --- App ---
NEXT_PUBLIC_APP_NAME=AquaLedger
NEXT_PUBLIC_APP_ENV=development
