# AquaLedger Frontend — Production Environment Template (Sprint 18
# Session 3)
#
# Unlike most env files, these NEXT_PUBLIC_* values must be supplied as
# Docker BUILD ARGS (see frontend/Dockerfile and docker-compose.prod.yml),
# not just container-runtime environment variables - Next.js inlines
# NEXT_PUBLIC_* values into the client bundle at `next build` time. This
# file documents what those build args should be; it is not read directly
# by the running container the way backend/.env.production.example is.

# Backend base URL as reached from INSIDE the Docker network, over the
# BFF layer (frontend/src/lib/auth/authenticated-backend-request.ts and
# friends) - the browser never calls this URL directly (confirmed: no
# client-side code imports frontend/src/lib/api-client.ts, the one place
# this value is also wired for a future direct-from-browser use). `backend`
# below is the Compose service name.
NEXT_PUBLIC_API_URL=http://backend:8000/api/v1

NEXT_PUBLIC_APP_NAME=AquaLedger
NEXT_PUBLIC_APP_ENV=production
